# Configuración del sistema de inventario físico vs SAP.
#
# Copiar a /etc/inventario.env y completar. El archivo tiene el secreto de
# Entra, así que:
#
#   sudo chown root:inventario /etc/inventario.env
#   sudo chmod 640 /etc/inventario.env
#
# Nunca va al repositorio.

# --- Entra ID (los tres primeros salen del registro de la aplicación en Azure)
INVSAP_TENANT_ID=00000000-0000-0000-0000-000000000000
INVSAP_CLIENT_ID=00000000-0000-0000-0000-000000000000
INVSAP_CLIENT_SECRET=
# Tiene que coincidir EXACTO con la URI de redirección registrada en Azure.
INVSAP_REDIRECT_URI=https://inventario.emergencias.com.ar/auth/callback

# --- quién puede entrar
INVSAP_DOMINIO=emergencias.com.ar

# --- red
# Con un proxy adelante (nginx, IIS), dejar 127.0.0.1: que sólo el proxy llegue.
INVSAP_HOST=127.0.0.1
INVSAP_PUERTO=8080
# El proxy termina el TLS, así que la cookie tiene que marcarse Secure igual.
INVSAP_COOKIE_SEGURA=si

# --- datos
INVSAP_DB=/opt/inventario/datos/inventario.db
INVSAP_RESPALDOS=/opt/inventario/datos/respaldos
INVSAP_RESPALDOS_CUANTOS=14
INVSAP_RESPALDO_HORA=3
INVSAP_HORAS_SESION=10

# --- registro de actividad
# Vacío = sólo a la salida estándar, que es lo que corresponde con systemd
# (queda en journalctl). Poner una ruta sólo si hace falta un archivo aparte.
INVSAP_LOG=
